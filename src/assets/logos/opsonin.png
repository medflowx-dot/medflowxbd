      <div id="map-container">
        <!-- <div class="container"> -->
          <div class="row">
            <div class="col-xs-12 col-sm-7 col-md-7">
              <div class="map-holder">
                <div id="map" style="height: 500px; width: 100%;"></div>
                <script>
                /* Custom Add */
                var gmarkers = [];
                /* END Custom Add */
                function initMap() {
                  var map = new google.maps.Map(document.getElementById('map'), {
                    zoom: 2,
                    center: {lat: 30, lng: 90},
                    scrollwheel: true,
                    draggable: true
                  });
                  setMarkers(map);
                }
                var beaches = [
                  ['Myanmar', 21.913965, 95.956223, 13],
                  ['Etc', 21.913965, 95.111111, 1],
                  ['Vietnam', 14.058324, 108.277199, 2],
                  ['Hong Kong', 22.396428, 114.109497 , 3],
                  ['Macau', 22.198745, 113.543873, 4],
                  ['Fiji', -16.578193, 179.414413, 5],
                  ['Philippines', 12.879721, 121.774017, 6],
                  ['Sri Lanka', 7.873054, 80.771797, 7],
                  ['Afghanistan', 33.93911, 67.709953, 8],
                  ['Kenya', -0.023559, 37.906193, 9],
                  ['Somalia', 5.152149, 46.199616, 10],
                  ['Bhutan', 27.514162, 90.433601, 11],
                  ['Georgia', 42.315407, 43.356892, 12]
                ];
                function setMarkers(map) {
                  var image = {
                    url: 'images/icons/marker.png',
                    size: new google.maps.Size(24, 34),
                    origin: new google.maps.Point(0, 0),
                    anchor: new google.maps.Point(0, 32)
                  };
                  var shape = {
                    coords: [1, 1, 1, 20, 18, 20, 18, 1],
                    type: 'poly'
                  };
                  for (var i = 0; i < beaches.length; i++) {
                    var beach = beaches[i];
                    var marker = new google.maps.Marker({
                      position: {lat: beach[1], lng: beach[2]},
                      map: map,
                      icon: image,
                      shape: shape,
                      title: beach[0],
                      zIndex: beach[3]
                    });
                    google.maps.event.addListener(marker, 'mouseover', (function(marker, i) {
                     return function() {
                       gmarkers[i].setAnimation(google.maps.Animation.BOUNCE);
                     }
                    })(marker, i));
                    google.maps.event.addListener(marker, 'mouseout', (function(marker, i) {
                     return function() {
                      gmarkers[i].setAnimation(null);
                     }
                    })(marker, i));
                    /* Custom Add */
                    gmarkers[i] = marker;
                    /* END Custom Add */
                  }// loop END
                  if($(window).width()<768){
                      var getlat = 45;
                      var getlng = 40;
                      var map_center = new google.maps.LatLng(getlat, getlng);
                      map.setCenter(map_center);
                      map.setZoom(2);
                  }else if($(window).width()<980){
                      var getlat = 45;
                      var getlng = 40;
                      var map_center = new google.maps.LatLng(getlat, getlng);
                      map.setCenter(map_center);
                      map.setZoom(3);
                  }else if($(window).width()<1200){
                      var getlat = 45;
                      var getlng = 40;
                      var map_center = new google.maps.LatLng(getlat, getlng);
                      map.setCenter(map_center);
                      map.setZoom(3);
                  }
                }
              </script>
              <script async defer
              src="https://maps.googleapis.com/maps/api/js?key=AIzaSyDc1oVnZH9b1PUOUxLrXGKN-27CjxwIC-E&callback=initMap">
              </script>
              <!-- Marker Animation -->
               <script type="text/javascript">
                function bounceAnimation(id){
                  gmarkers[id].setAnimation(google.maps.Animation.BOUNCE);
                }
                function bounceAnimationStop(id){
                  gmarkers[id].setAnimation(null);
                }
              </script>
               <!-- End Marker Animation -->
              </div>
            </div><!-- /col -->
