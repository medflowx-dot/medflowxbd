        <script type="text/javascript">
            $(function () {
            $('.tab-content:not(:first)').hide();
            $('#tabs-nav a').bind('click', function (e) {
                e.preventDefault();
                $this = $(this);
                $target = $(this.hash);
                $('#tabs-nav a.current').removeClass('current');
                $('.tab-content:visible').fadeOut("slow", function () {
                    $this.addClass('current');
                    $target.fadeIn("slow");
                });
            }).filter(':first').click();
            });
        </script>


        <!-- Sidebar Menu -->
        <script type="text/javascript">
          $(document).ready(function() {

              if($(window).width()<490){
                $('#sidebar').css('width', '70px');
              }

              $('.hamburger-menu').click(function() {
                if($('#sidebar').hasClass('expand')){

                  $('#sidebar').removeClass('expand');
                  
                  $('.menu_content h2 span, .menu_content a.top-logo span').css('left', '0px');

                  if($(window).width()<490){
                    setTimeout( function(){ 
                      $('#sidebar').animate({
                        width: "70px"
                      });

                      $('#side-logo, #vertical-contact-ul, .enquiry-button').show();
                      $('.nav-ul li, .fonts-ul, #contact-ul, .menu_content h2, .menu_content a.top-logo').hide();
                    }  , 550 );
                  }else{
                    setTimeout( function(){ 
                      $('#sidebar').animate({
                        width: "95px"
                      });

                      $('#side-logo, #vertical-contact-ul, .enquiry-button').show();
                      $('.nav-ul li, .fonts-ul, #contact-ul, .menu_content h2, .menu_content a.top-logo').hide();
                    }  , 550 );
                  }
                  
                }else{
                  $('#sidebar').addClass('expand');
                  $('#vertical-contact-ul, #side-logo, .enquiry-button').hide();
                  
                  if($(window).width()<490){
                    $('#sidebar').animate({
                        width: "315px"
                    }, function(){
                      $('.menu_content h2, .menu_content a.top-logo').fadeIn();
                      $('.menu_content h2 span, .menu_content a.top-logo span').animate({
                          left: "125px"
                      });

                    });
                  }else{
                    $('#sidebar').animate({
                        width: "420px"
                    }, function(){
                      $('.menu_content h2, .menu_content a.top-logo').fadeIn();
                      $('.menu_content h2 span, .menu_content a.top-logo span').animate({
                          left: "300px"
                      });

                    });
                  }
                  
                  setTimeout( function(){ 
                    $('.fonts-ul').fadeIn();
                  }  , 2400 );

                  setTimeout( function(){ 
                    $('#contact-ul').fadeIn();
                  }  , 2600 );

                  setTimeout( function(){ 

                    iterator( $('.nav-ul li').hide().first() );
                    function iterator( el ) {
                        el.fadeIn(150, function() { iterator( el.next() ); } )
                    }

                  }, 1200);

                }// END else
                  
              });

              $('#main-body').click(function() {
                  $('#sidebar').removeClass('expand');
                  
                  $('.menu_content h2 span, .menu_content a.top-logo span').css('left', '0px');

                  if($(window).width()<490){
                    setTimeout( function(){ 
                      $('#sidebar').animate({
                        width: "70px"
                      });

                      $('#side-logo, #vertical-contact-ul, .enquiry-button').show();
                      $('.nav-ul li, .fonts-ul, #contact-ul, .menu_content h2, .menu_content a.top-logo').hide();
                    }  , 550 );
                  }else{
                    setTimeout( function(){ 
                      $('#sidebar').animate({
                        width: "95px"
                      });

                      $('#side-logo, #vertical-contact-ul, .enquiry-button').show();
                      $('.nav-ul li, .fonts-ul, #contact-ul, .menu_content h2, .menu_content a.top-logo').hide();
                    }  , 550 );
                  }
                  
                  
              });

          });

          //main menu sub navi
          $('.nav-ul li > .submenu').parent().click(function() {
            var submenu = $(this).children('.submenu');
            if ( $(submenu).is(':hidden') ) {
              $(submenu).slideDown(200);
            } else {
              $(submenu).slideUp(200);
            }
          });
        </script>

