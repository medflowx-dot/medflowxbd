        <script type="text/javascript">
            // modify url
            function addVariable() {
              var form = document.getElementById("myForm");
              var action = form.getAttribute("action");
              var inputValue = form.elements["pid"].value;
              
              // Append the variable to the action URL
              var updatedAction = action + "?pid=" + inputValue;
              
              // Update the form's action
              form.setAttribute("action", updatedAction);
              
              // Submit the form
              form.submit();
            }

            // modify url generics
            function addVariable() {
              var form = document.getElementById("myFormGen");
              var action = form.getAttribute("action");
              var inputValue = form.elements["gid"].value;
              
              // Append the variable to the action URL
              var updatedAction = action + "?gid=" + inputValue;
              
              // Update the form's action
              form.setAttribute("action", updatedAction);
              
              // Submit the form
              form.submit();
            }
        </script>

